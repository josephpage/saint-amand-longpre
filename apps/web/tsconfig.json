{
  "extends": ["astro/tsconfigs/strictest", "../../tsconfig.base.json"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["node"],
    "paths": {
      "~/*": ["./src/*"]
    },
    "exactOptionalPropertyTypes": false
  },
  "include": [".astro/types.d.ts", "src", "tests", "integrations", "scripts", "*.ts"],
  "exclude": ["dist"]
}
