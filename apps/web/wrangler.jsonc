// Projet Cloudflare Pages « saint-amand-longpre » (compte « Mairie de Saint-Amand-Longpré »).
// Ce fichier fait foi : `wrangler pages deploy` applique ces réglages au projet, qui ne sont
// plus modifiables depuis le tableau de bord. Les secrets se déclarent à part :
//   npx wrangler pages secret put <NOM> --project-name saint-amand-longpre
// (BREVO_API_KEY, TURNSTILE_SECRET, PREVIEW_SECRET, WP_PREVIEW_USER, WP_PREVIEW_APP_PASSWORD).
//
// Seules /api/* et /preview/* passent par la fonction (dist/client/_routes.json) ; tout le
// reste est servi en statique, avec les redirections de dist/client/_redirects.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saint-amand-longpre",
  "pages_build_output_dir": "./dist/client",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // Local (`pnpm preview`, tests de bout en bout) : jeu de données, e-mails simulés,
  // clé Turnstile de test. Les secrets locaux viennent de .dev.vars.
  "vars": {
    "CONTENT_SOURCE": "fixtures",
    "WP_GRAPHQL_URL": "http://localhost:8080/graphql",
    "MAIL_FROM": "site@saintamandlongpre.fr",
    "MAIL_DRY_RUN": "true",
    "TURNSTILE_SECRET": "1x0000000000000000000000000000000AA",
    "PREVIEW_SECRET": "dev-preview-secret-change-me",
  },

  "env": {
    // Déploiements de production (branche main) : www.saintamandlongpre.fr.
    "production": {
      "vars": {
        "CONTENT_SOURCE": "wordpress",
        "WP_GRAPHQL_URL": "https://cms.saintamandlongpre.fr/graphql",
        "MAIL_FROM": "site@saintamandlongpre.fr",
        "MAIL_TO": "secretariat@saintamandlongpre.fr",
        "MAIL_DRY_RUN": "false",
      },
    },
    // Déploiements d'aperçu (autres branches, *.saint-amand-longpre.pages.dev) :
    // contenu de production, mais aucun e-mail envoyé.
    "preview": {
      "vars": {
        "CONTENT_SOURCE": "wordpress",
        "WP_GRAPHQL_URL": "https://cms.saintamandlongpre.fr/graphql",
        "MAIL_FROM": "site@saintamandlongpre.fr",
        "MAIL_DRY_RUN": "true",
      },
    },
  },
}
