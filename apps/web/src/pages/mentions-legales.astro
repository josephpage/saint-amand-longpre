---
import PageHeader from '~/components/PageHeader.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getContent } from '~/lib/content/index.ts';
import { BLASON, LEGAL } from '~/site.config.ts';

const { settings, elected } = await getContent();
const mayor = elected.find((e) => e.role === 'maire');
---

<BaseLayout title="Mentions légales">
  <PageHeader
    title="Mentions légales"
    crumbs={[
      { label: 'Accueil', href: '/' },
      { label: 'Mentions légales', href: '/mentions-legales/' },
    ]}
  />
  <div class="container-site prose-sal py-10">
    <h2>Éditeur du site</h2>
    <p>
      {LEGAL.publisher}
      <br />
      Mairie, {settings.street}, {settings.postalCode} {settings.city}
      <br />
      Téléphone : {settings.phone}
      <br />
      E-mail : <a href={`mailto:${LEGAL.email}`}>{LEGAL.email}</a>
    </p>
    <h2>Directeur ou directrice de la publication</h2>
    <p>
      {mayor ? `${mayor.name}, maire de Saint-Amand-Longpré.` : 'Le maire de Saint-Amand-Longpré.'}
    </p>
    <h2>Hébergement</h2>
    <p>
      {LEGAL.host.name}, {LEGAL.host.address} :<a href={LEGAL.host.url}>cloudflare.com</a>.
    </p>
    <p>
      Le site public est servi par Cloudflare Pages. L’outil de gestion des contenus
      (cms.saintamandlongpre.fr) est hébergé sur un serveur dédié de la commune.
    </p>
    <h2>Propriété intellectuelle</h2>
    <p>
      Les textes, photographies et documents publiés sur ce site appartiennent à la commune ou à
      leurs auteurs. Toute réutilisation doit être demandée à la mairie. Les documents
      administratifs (comptes rendus, délibérations, arrêtés) sont librement réutilisables en citant
      la source.
    </p>
    <p>
      Fonds de carte : © contributeurs{' '}
      <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>, sous licence ODbL.
    </p>
    <h2>Crédits</h2>
    <p>
      {`Blason de Saint-Amand-Longpré (${BLASON.blazon}) : fichier « `}
      <a href={BLASON.sourceUrl}>{BLASON.title}</a>
      {' » par '}
      <a href={BLASON.authorUrl}>{BLASON.author}</a>
      {', publié sur Wikimedia Commons sous licence '}
      <a href={BLASON.licenseUrl}>
        {`Creative Commons Attribution – Partage dans les mêmes conditions 3.0 (${BLASON.license})`}
      </a>
      {'. Le fichier est utilisé sans modification.'}
    </p>
    <h2>Données personnelles et cookies</h2>
    <p>
      Voir la page <a href="/donnees-personnelles/">Données personnelles</a>. Ce site ne dépose
      aucun cookie de mesure d’audience ni de publicité.
    </p>
  </div>
</BaseLayout>
