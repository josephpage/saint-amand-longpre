---
import { Image } from 'astro:assets';
import HelpBox from '~/components/HelpBox.astro';
import Icon from '~/components/Icon.astro';
import PageHeader from '~/components/PageHeader.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { breadcrumb, getContent } from '~/lib/content/index.ts';
import { SECTION_LABELS } from '~/lib/navigation.ts';

const content = await getContent();
const path = '/demarches/louer-une-salle/';
---

<BaseLayout
  title="Louer une salle"
  description="Salles communales de Saint-Amand-Longpré à louer : capacité, équipements, tarifs et règlement."
>
  <PageHeader
    title="Louer une salle"
    crumbs={breadcrumb(content.pages, path, SECTION_LABELS)}
    intro="La commune loue ses salles aux particuliers et aux associations. Consultez la fiche de chaque salle pour les tarifs et le règlement, puis contactez la mairie pour réserver."
  />
  <div class="container-site grid gap-10 py-10 lg:grid-cols-[1fr_20rem]">
    <ul class="grid gap-6 sm:grid-cols-2" data-pagefind-body>
      {content.rooms.map((room) => (
        <li class="card group relative flex flex-col overflow-hidden">
          {room.photos[0] ? (
            <Image
              src={room.photos[0].src}
              alt=""
              width={room.photos[0].width ?? 800}
              height={room.photos[0].height ?? 600}
              widths={[400, 800]}
              sizes="(min-width: 640px) 50vw, 100vw"
              class="aspect-[4/3] w-full object-cover"
            />
          ) : (
            <div
              class="grid aspect-[4/3] w-full place-items-center bg-pierre text-muted"
              aria-hidden="true"
            >
              <Icon name="building" class="icon size-12 stroke-[1.3]" />
            </div>
          )}
          <div class="flex flex-1 flex-col gap-2 p-5">
            <h2 class="text-xl">
              <a
                href={`${path}${room.slug}/`}
                class="text-encre no-underline after:absolute after:inset-0 group-hover:underline"
              >
                {room.title}
              </a>
            </h2>
            {room.capacity && (
              <p class="inline-flex items-center gap-2 text-sm font-bold text-bocage">
                <Icon name="users" class="icon size-5" />
                Jusqu’à {room.capacity} personnes{room.seated ? ` (${room.seated} assises)` : ''}
              </p>
            )}
            {room.excerpt && <p class="text-sm text-muted">{room.excerpt}</p>}
          </div>
        </li>
      ))}
    </ul>
    <HelpBox settings={content.settings} />
  </div>
</BaseLayout>
