---
import DirectoryList from '~/components/DirectoryList.astro';
import PageHeader from '~/components/PageHeader.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { breadcrumb, directoryOf, getContent } from '~/lib/content/index.ts';
import { SECTION_LABELS } from '~/lib/navigation.ts';

const content = await getContent();
const path = '/vivre-ici/associations/';
---

<BaseLayout
  title="Associations"
  description="L'annuaire des associations de Saint-Amand-Longpré : sport, culture, solidarité, patrimoine."
>
  <PageHeader
    title="Associations"
    crumbs={breadcrumb(content.pages, path, SECTION_LABELS)}
    intro="Les associations font vivre la commune. Retrouvez leurs activités et leurs contacts."
  />
  <div class="container-site py-10">
    <DirectoryList entries={directoryOf(content.directory, ['association'])} detailBase={path} />
  </div>
</BaseLayout>
