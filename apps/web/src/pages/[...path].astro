---
import type { GetStaticPaths } from 'astro';
import HelpBox from '~/components/HelpBox.astro';
import LinkCards from '~/components/LinkCards.astro';
import PageHeader from '~/components/PageHeader.astro';
import Prose from '~/components/Prose.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { breadcrumb, childrenOf, getContent, type Page } from '~/lib/content/index.ts';
import {
  buildNavigation,
  SECTION_LABELS,
  VIRTUAL_PAGES,
  type NavItem,
  type NavSection,
} from '~/lib/navigation.ts';

export const getStaticPaths = (async () => {
  // Pages ayant leur propre route : elles ne doivent pas être générées ici.
  const RESERVED = new Set(Object.values(VIRTUAL_PAGES).map((v) => v.href));
  const content = await getContent();
  const sections = buildNavigation(content.pages).filter((s) => s.key !== 'agenda');
  const sectionPaths = sections.map((section) => ({
    params: { path: section.href.slice(1, -1) },
    props: { kind: 'section' as const, section },
  }));
  const pagePaths = content.pages
    .filter((page) => !RESERVED.has(page.path) && !sections.some((s) => s.href === page.path))
    .map((page) => ({
      params: { path: page.path.slice(1, -1) },
      props: { kind: 'page' as const, page },
    }));
  return [...sectionPaths, ...pagePaths];
}) satisfies GetStaticPaths;

type Props = { kind: 'section'; section: NavSection } | { kind: 'page'; page: Page };

const content = await getContent();
const props = Astro.props as Props;

/** Liens complémentaires affichés sous certaines pages. */
const EXTRA_CHILDREN: Record<string, NavItem[]> = {
  '/mairie/conseil-municipal/': [VIRTUAL_PAGES.elus!, VIRTUAL_PAGES.comptesRendus!],
};

let title: string;
let intro: string | undefined;
let html = '';
let children: NavItem[];
let siblings: NavItem[] = [];
let path: string;
let modified: string | undefined;

if (props.kind === 'section') {
  ({ label: title, intro, href: path } = props.section);
  children = props.section.items;
} else {
  const { page } = props;
  ({ title, html, path, modified } = page);
  children = [
    ...(EXTRA_CHILDREN[page.path] ?? []),
    ...childrenOf(content.pages, page.path).map((p) => ({
      label: p.title,
      href: p.path,
      ...(p.excerpt ? { description: p.excerpt } : {}),
    })),
  ];
  if (page.parentPath) {
    siblings = childrenOf(content.pages, page.parentPath).map((p) => ({
      label: p.title,
      href: p.path,
    }));
  }
}
const crumbs = breadcrumb(content.pages, path, SECTION_LABELS);
const showHelp = path.startsWith('/demarches/') || path.startsWith('/mairie/');
const description = props.kind === 'page' ? props.page.excerpt : intro;
---

<BaseLayout title={title} {...(description ? { description } : {})}>
  <PageHeader
    title={title}
    crumbs={crumbs}
    {...(intro ? { intro } : {})}
    {...(modified ? { modified } : {})}
  />
  <div class="container-site grid gap-10 py-10 lg:grid-cols-[1fr_20rem]">
    <div class="min-w-0" data-pagefind-body>
      {html && <Prose html={html} />}
      {children.length > 0 && (
        <section class:list={[html && 'mt-12']} aria-labelledby="titre-sous-pages">
          <h2 id="titre-sous-pages" class:list={['mb-5 text-2xl', !html && 'sr-only']}>
            {props.kind === 'section' ? `Dans la rubrique « ${title} »` : 'Pour aller plus loin'}
          </h2>
          <LinkCards items={children} headingLevel="h3" />
        </section>
      )}
      {!html && children.length === 0 && (
        <p class="text-muted">Cette page sera complétée prochainement.</p>
      )}
    </div>
    <div class="grid content-start gap-6">
      {siblings.length > 1 && (
        <nav aria-labelledby="titre-rubrique" class="card p-5">
          <h2 id="titre-rubrique" class="text-lg">
            Dans cette rubrique
          </h2>
          <ul class="mt-3 grid gap-1 text-[0.95rem]">
            {siblings.map((s) => (
              <li>
                <a
                  href={s.href}
                  class:list={[
                    'block rounded px-2 py-1.5 no-underline',
                    s.href === path
                      ? 'bg-terracotta-soft font-bold text-terracotta-text'
                      : 'text-encre hover:bg-lin',
                  ]}
                  aria-current={s.href === path ? 'page' : undefined}
                >
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      {showHelp && <HelpBox settings={content.settings} />}
    </div>
  </div>
</BaseLayout>
