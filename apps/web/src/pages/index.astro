---
import { Image } from 'astro:assets';
import EventCard from '~/components/EventCard.astro';
import Icon, { type IconName } from '~/components/Icon.astro';
import NewsCard from '~/components/NewsCard.astro';
import OpeningStatus from '~/components/OpeningStatus.astro';
import Ribbons from '~/components/Ribbons.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { activeAlerts, getContent, latestNews, upcomingEvents } from '~/lib/content/index.ts';
import { todayInParis } from '~/lib/dates.ts';
import { summarizeHours } from '~/lib/hours.ts';
import { BADGE, SURFACE, type Tone } from '~/lib/theme.ts';

const content = await getContent();
const { settings } = content;
const today = todayInParis();
const news = latestNews(content.news, 3);
const events = upcomingEvents(content.events, today).slice(0, 3);
const alert = activeAlerts(content.alerts, today)[0];
const hours = summarizeHours(settings.hours);
const salle = content.rooms.find((r) => r.photos.length > 0);
const hasMap = settings.latitude !== undefined && settings.longitude !== undefined;

const services: { icon: IconName; tone: Tone; title: string; text: string; href: string }[] = [
  {
    icon: 'file',
    tone: 'nuit',
    title: 'Faire une démarche',
    text: 'État civil, papiers, démarches en ligne',
    href: '/demarches/',
  },
  {
    icon: 'cap',
    tone: 'jaune',
    title: 'École et enfance',
    text: 'Syndicat scolaire, cantine, garderie',
    href: '/vivre-ici/ecole-et-enfance/',
  },
  {
    icon: 'home',
    tone: 'riviere',
    title: 'Urbanisme',
    text: 'Permis de construire, PLUi-H, autorisations',
    href: '/demarches/urbanisme/',
  },
  {
    icon: 'megaphone',
    tone: 'rouge',
    title: 'Signaler un problème',
    text: 'Voirie, éclairage, espaces publics',
    href: '/signaler-un-probleme/',
  },
];

const demarches: { icon: IconName; label: string; href: string }[] = [
  {
    icon: 'file',
    label: 'Acte d’état civil',
    href: '/demarches/etat-civil/copie-integrale-d-actes/',
  },
  {
    icon: 'ballot',
    label: 'Inscription sur les listes électorales',
    href: 'https://www.service-public.fr/particuliers/vosdroits/R16396',
  },
  { icon: 'home', label: 'Demande d’urbanisme', href: '/demarches/urbanisme/autorisations/' },
  { icon: 'key', label: 'Location de salle communale', href: '/demarches/louer-une-salle/' },
  {
    icon: 'cap',
    label: 'Inscription scolaire',
    href: '/vivre-ici/ecole-et-enfance/inscription-des-eleves/',
  },
  {
    icon: 'id',
    label: 'Recensement citoyen',
    href: 'https://www.service-public.fr/particuliers/vosdroits/R870',
  },
];

const tiles: {
  icon: IconName;
  label: string;
  href: string;
  image?: { src: string; width?: number; height?: number };
  tone: Tone;
}[] = [
  { icon: 'users', label: 'Associations', href: '/vivre-ici/associations/', tone: 'rouge' },
  {
    icon: 'store',
    label: 'Commerces et entreprises',
    href: '/vivre-ici/commerces-et-entreprises/',
    tone: 'riviere',
  },
  { icon: 'cap', label: 'École et enfance', href: '/vivre-ici/ecole-et-enfance/', tone: 'jaune' },
  {
    icon: 'key',
    label: 'Salles communales',
    href: '/demarches/louer-une-salle/',
    tone: 'nuit',
    ...(salle?.photos[0] ? { image: salle.photos[0] } : {}),
  },
  {
    icon: 'building',
    label: 'Conseil municipal',
    href: '/mairie/conseil-municipal/elus/',
    tone: 'nuit',
  },
  {
    icon: 'church',
    label: 'Découvrir la commune',
    href: '/decouvrir/',
    tone: 'sauge',
    ...(settings.heroImage ? { image: settings.heroImage } : {}),
  },
];

/** Les trois piliers de la charte : patrimoine, nature, avenir. */
const pillars: {
  icon: IconName;
  tone: Tone;
  title: string;
  text: string;
  href: string;
  link: string;
}[] = [
  {
    icon: 'church',
    tone: 'rouge',
    title: 'Patrimoine et histoire',
    text: 'Deux anciens bourgs réunis en 1965, l’église et la chapelle Notre-Dame de Villethiou.',
    href: '/decouvrir/la-commune/',
    link: 'La commune en bref',
  },
  {
    icon: 'leaf',
    tone: 'sauge',
    title: 'Nature et paysages',
    text: 'La vallée de la Brenne, les chemins et la campagne du Vendômois.',
    href: '/decouvrir/photos/',
    link: 'Voir les photos',
  },
  {
    icon: 'sprout',
    tone: 'riviere',
    title: 'Projets et avenir',
    text: 'Urbanisme, travaux, école : les projets qui préparent la commune de demain.',
    href: '/actualites/',
    link: 'Suivre les actualités',
  },
];
---

<BaseLayout
  title="Mairie de Saint-Amand-Longpré (Loir-et-Cher)"
  rawTitle
  hideAlerts
  description="Site officiel de la commune de Saint-Amand-Longpré : démarches, horaires de la mairie, actualités, agenda, associations et vie locale."
>
  <section class="relative isolate overflow-hidden bg-nuit" aria-labelledby="titre-accueil">
    {settings.heroImage && (
      <Image
        src={settings.heroImage.src}
        alt=""
        width={settings.heroImage.width ?? 1600}
        height={settings.heroImage.height ?? 1000}
        widths={[800, 1200, 1600, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 -z-10 size-full object-cover object-[60%_35%]"
      />
    )}
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(0deg,rgba(31,41,55,.9),rgba(31,41,55,.5)_60%,rgba(31,41,55,.25))] md:bg-[linear-gradient(90deg,rgba(31,41,55,.88)_0%,rgba(31,41,55,.55)_42%,rgba(31,41,55,0)_72%)]"></div>
    <svg
      class="pointer-events-none absolute -right-24 bottom-10 -z-10 hidden h-[115%] w-auto md:block lg:-right-10"
      viewBox="0 0 400 600"
      aria-hidden="true"
    >
      <path fill="#c12a2a" d="M140 600C280 430 250 250 400 30v100C310 280 330 440 235 600Z"></path>
      <path fill="#f4c430" d="M265 600c80-120 55-250 135-380v80c-50 90-20 200-75 300Z"></path>
      <path fill="#6c8f64" d="M345 600c40-70 30-140 55-200v50c-15 50-5 100-25 150Z"></path>
    </svg>
    <div class="container-site pt-16 pb-44 text-white sm:pt-24 md:pb-52">
      <p class="eyebrow text-jaune">
        Ville de Saint-Amand-Longpré<span class="hidden sm:inline"> · Loir-et-Cher</span>
      </p>
      <h1
        id="titre-accueil"
        class="title-bar mt-4 max-w-2xl font-serif text-4xl leading-[1.1] font-medium tracking-normal text-white sm:text-5xl lg:text-[3.6rem]"
      >
        Saint-Amand-Longpré, entre patrimoine, nature et avenir
      </h1>
      <p class="mt-5 max-w-lg text-lg text-white/90">
        {settings.population
          ? `${settings.population.toLocaleString('fr-FR').replace(/\s/g, '\u00a0')} habitants, deux`
          : 'Deux'}{' '}
        anciens bourgs réunis en 1965 : Saint-Amand-de-Vendôme et Longpré. Patrimoine, campagne et
        services de proximité.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/demarches/" class="btn">
          Faire une démarche <Icon name="arrow-right" class="icon size-5" />
        </a>
        <a
          href="/decouvrir/"
          class="inline-flex items-center gap-2 rounded-full border border-white/60 px-5 py-2.5 font-display text-[0.95rem] font-semibold text-white no-underline hover:bg-white/10"
        >
          Découvrir la commune
        </a>
      </div>
    </div>
    {settings.heroImage && (
      <p class="absolute top-3 right-4 text-xs text-white/85 [text-shadow:0_1px_2px_rgba(0,0,0,.7)]">
        © Commune de Saint-Amand-Longpré
      </p>
    )}
    <Ribbons class="absolute inset-x-0 -bottom-px h-20 sm:h-28 lg:h-32" />
  </section>

  <div class="container-site relative z-10 -mt-20 sm:-mt-24">
    <h2 class="sr-only">Accès rapides</h2>
    <ul class="grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-5">
      {services.map((s) => (
        <li class="card group relative flex flex-col gap-3 p-4 transition-transform hover:-translate-y-0.5 sm:p-6">
          <span class:list={['grid size-12 place-items-center rounded-full', BADGE[s.tone]]}>
            <Icon name={s.icon} class="icon size-6" />
          </span>
          <a
            href={s.href}
            class="font-display text-base font-bold text-nuit no-underline after:absolute after:inset-0 group-hover:underline sm:text-lg"
          >
            {s.title}
          </a>
          <p class="hidden text-sm text-muted sm:block">{s.text}</p>
        </li>
      ))}
    </ul>

    {alert && (
      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-card border-l-4 border-jaune bg-white px-5 py-3.5 shadow-card">
        <span class="grid size-9 place-items-center rounded-full bg-jaune-soft text-nuit">
          <Icon name="info" class="icon size-5" />
        </span>
        <p class="eyebrow text-nuit">À la une</p>
        <p class="text-[0.95rem]">
          <strong class="font-display">{alert.title}</strong> : {alert.message}
        </p>
        {alert.link && (
          <a href={alert.link} class="link-more ml-auto">
            En savoir plus <Icon name="arrow-right" class="icon size-4" />
          </a>
        )}
      </div>
    )}
  </div>

  <div class="container-site mt-16 grid gap-12 lg:grid-cols-[1.9fr_1fr]">
    <section aria-labelledby="titre-actus">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-2">
        <div>
          <p class="eyebrow text-rouge">Vie de la commune</p>
          <h2 id="titre-actus" class="title-bar mt-2 text-3xl">
            Actualités de la commune
          </h2>
        </div>
        <a href="/actualites/" class="link-more">
          Toutes les actualités <Icon name="arrow-right" class="icon size-4" />
        </a>
      </div>
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {news.map((item, index) => (
          <li class="flex">
            <NewsCard news={item} eager={index === 0} />
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="titre-agenda">
      <div class="mb-6">
        <p class="eyebrow text-rouge">Agenda</p>
        <h2 id="titre-agenda" class="title-bar mt-2 text-3xl">
          Prochains rendez-vous
        </h2>
      </div>
      {events.length > 0 ? (
        <ul class="grid gap-3.5">
          {events.map((event) => (
            <li>
              <EventCard event={event} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="card p-5 text-muted">
          Aucun rendez-vous n’est annoncé pour le moment. Consultez les actualités ou revenez
          bientôt.
        </p>
      )}
      <p class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
        <a href="/agenda/" class="link-more">
          Voir tout l’agenda <Icon name="arrow-right" class="icon size-4" />
        </a>
        <a href="/agenda.ics" class="link-more">
          S’abonner au calendrier <Icon name="calendar" class="icon size-4" />
        </a>
      </p>
    </section>
  </div>

  <section class="container-site mt-20" aria-labelledby="titre-demarches">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-2">
      <div>
        <p class="eyebrow text-rouge">En ligne ou en mairie</p>
        <h2 id="titre-demarches" class="title-bar mt-2 text-3xl">
          Vos démarches les plus demandées
        </h2>
      </div>
      <a href="/demarches/" class="link-more">
        Toutes les démarches <Icon name="arrow-right" class="icon size-4" />
      </a>
    </div>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {demarches.map((d) => (
        <li class="card group relative grid justify-items-center gap-3 px-3 py-6 text-center transition-transform hover:-translate-y-0.5">
          <span class="grid size-14 place-items-center rounded-full bg-sable text-nuit transition-colors group-hover:bg-jaune-soft">
            <Icon name={d.icon} class="icon size-7" />
          </span>
          <a
            href={d.href}
            class="font-display text-[0.9rem] leading-snug font-semibold text-nuit no-underline after:absolute after:inset-0 group-hover:underline"
          >
            {d.label}
            {d.href.startsWith('http') && <span class="sr-only"> (site Service-Public.fr)</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-16 bg-white" aria-labelledby="titre-piliers">
    <Ribbons fill="text-white" class="h-16 bg-sable sm:h-24" flip />
    <div class="container-site py-14">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow text-rouge">Notre identité</p>
        <h2 id="titre-piliers" class="title-bar-center mt-2 text-3xl">
          Une commune entre patrimoine, nature et avenir
        </h2>
      </div>
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {pillars.map((p) => (
          <li class="group relative rounded-card bg-sable p-6 transition-transform hover:-translate-y-0.5 sm:p-7">
            <span class:list={['grid size-14 place-items-center rounded-full', BADGE[p.tone]]}>
              <Icon name={p.icon} class="icon size-7" />
            </span>
            <h3 class="mt-4 text-xl">{p.title}</h3>
            <p class="mt-2 text-[0.95rem] text-muted">{p.text}</p>
            <a href={p.href} class="link-more mt-4 after:absolute after:inset-0">
              {p.link} <Icon name="arrow-right" class="icon size-4" />
            </a>
          </li>
        ))}
      </ul>
    </div>
    <Ribbons class="h-16 sm:h-24" />
  </section>

  <section class="py-12" aria-labelledby="titre-vivre">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <div>
          <p class="eyebrow text-rouge">Au quotidien</p>
          <h2 id="titre-vivre" class="title-bar mt-2 text-3xl">
            Vivre à Saint-Amand-Longpré
          </h2>
        </div>
        <a href="/vivre-ici/" class="link-more">
          Tous les services <Icon name="arrow-right" class="icon size-4" />
        </a>
      </div>
      <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
        {tiles.map((t) => (
          <li
            class:list={[
              'group relative aspect-[4/3] overflow-hidden rounded-card text-white sm:aspect-[3/4]',
              !t.image && ['motif-ecailles', SURFACE[t.tone]],
            ]}
          >
            {t.image ? (
              <>
                <Image
                  src={t.image.src}
                  alt=""
                  width={t.image.width ?? 600}
                  height={t.image.height ?? 800}
                  widths={[300, 600]}
                  sizes="(min-width: 1024px) 12rem, 50vw"
                  class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-[linear-gradient(0deg,rgba(31,41,55,.85)_0%,rgba(31,41,55,.1)_60%,transparent_75%)]" />
              </>
            ) : (
              <Icon
                name={t.icon}
                class="icon absolute top-4 right-4 size-14 stroke-[1.2] opacity-40 transition-transform duration-500 group-hover:scale-110"
              />
            )}
            <div class="absolute inset-x-4 bottom-4 grid gap-2">
              <span class="block h-1 w-8 rounded-full bg-jaune" aria-hidden="true"></span>
              <a
                href={t.href}
                class="font-display text-[0.8rem] leading-snug font-bold tracking-[0.1em] text-white uppercase no-underline after:absolute after:inset-0 sm:text-sm"
              >
                {t.label}
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section
    class="container-site mt-6 grid gap-5 lg:grid-cols-[1fr_1.4fr]"
    aria-labelledby="titre-mairie"
  >
    <div class="card grid content-start gap-4 p-6 sm:p-8">
      <h2 id="titre-mairie" class="title-bar text-3xl">
        Mairie pratique
      </h2>
      <OpeningStatus hours={settings.hours} class="justify-self-start" />
      <ul class="grid gap-4 text-[0.95rem]">
        <li class="grid grid-cols-[1.5rem_1fr] gap-3">
          <Icon name="pin" class="icon text-rouge" />
          <address class="not-italic">
            {settings.street}
            <br />
            {settings.postalCode} {settings.city}
          </address>
        </li>
        <li class="grid grid-cols-[1.5rem_1fr] gap-3">
          <Icon name="clock" class="icon text-rouge" />
          <div>
            <p class="font-display font-semibold">Horaires d’ouverture</p>
            <dl>
              {hours.map((line) => (
                <div>
                  <dt class="inline">{line.days} :</dt> <dd class="inline">{line.hours}</dd>
                </div>
              ))}
            </dl>
          </div>
        </li>
        <li class="grid grid-cols-[1.5rem_1fr] gap-3">
          <Icon name="phone" class="icon text-rouge" />
          <a
            href={`tel:${settings.phone.replace(/\s/g, '')}`}
            class="font-display text-xl font-bold text-nuit no-underline"
          >
            {settings.phone}
          </a>
        </li>
      </ul>
      <a href="/contact/" class="btn justify-self-start">
        Contacter la mairie <Icon name="arrow-right" class="icon size-5" />
      </a>
    </div>
    {hasMap && (
      <figure class="relative min-h-72 overflow-hidden rounded-card bg-sable-dark shadow-card">
        <img
          src="/images/plan-mairie.webp"
          alt={`Plan de situation de la mairie, ${settings.street} à ${settings.city}`}
          width="1200"
          height="800"
          loading="lazy"
          class="absolute inset-0 size-full object-cover"
        />
        <span
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-full text-rouge"
          aria-hidden="true"
        >
          <svg viewBox="0 0 24 32" class="h-10 w-8 drop-shadow">
            <path d="M12 31s10-9.4 10-18A10 10 0 0 0 2 13c0 8.6 10 18 10 18z" fill="currentColor" />
            <circle cx="12" cy="12" r="4" fill="#fff" />
          </svg>
        </span>
        <figcaption class="absolute right-3 bottom-3 left-3 flex flex-wrap items-end justify-between gap-2">
          <span class="rounded bg-white/85 px-1.5 py-0.5 text-xs text-muted">
            ©{' '}
            <a href="https://www.openstreetmap.org/copyright" class="text-muted">
              contributeurs OpenStreetMap
            </a>
          </span>
          <a
            class="btn-ghost"
            href={`https://www.openstreetmap.org/directions?to=${settings.latitude}%2C${settings.longitude}#map=17/${settings.latitude}/${settings.longitude}`}
          >
            Voir l’itinéraire <Icon name="navigation" class="icon size-5" />
          </a>
        </figcaption>
      </figure>
    )}
  </section>
</BaseLayout>
