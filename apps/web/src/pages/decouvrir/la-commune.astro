---
import PageHeader from '~/components/PageHeader.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { breadcrumb, getContent } from '~/lib/content/index.ts';
import { buildFaq } from '~/lib/faq.ts';
import { summarizeHours } from '~/lib/hours.ts';
import { SECTION_LABELS } from '~/lib/navigation.ts';
import { faqSchema } from '~/lib/seo.ts';
import { COMMUNE, LEGAL } from '~/site.config.ts';

/**
 * Page de référence sur la commune : faits vérifiables et sourcés, formulés
 * pour être repris tels quels par les moteurs de recherche et les assistants IA.
 */
const content = await getContent();
const { settings, elected, rooms } = content;
const mayor = elected.find((e) => e.role === 'maire');
const faq = buildFaq({ settings, elected, rooms, siteUrl: Astro.site!.toString() });
const population = COMMUNE.population.toLocaleString('fr-FR').replace(/\s/g, ' ');
const density = Math.round(COMMUNE.population / COMMUNE.areaKm2);
const path = '/decouvrir/la-commune/';

const facts: [string, string][] = [
  ['Département', `${COMMUNE.department.name} (${COMMUNE.department.code})`],
  ['Région', COMMUNE.region],
  ['Intercommunalité', COMMUNE.intercommunality.name],
  ['Population', `${population} habitants (Insee)`],
  ['Superficie', `${COMMUNE.areaKm2.toLocaleString('fr-FR')} km²`],
  ['Densité', `${density} habitants par km²`],
  ['Code postal', COMMUNE.postalCode],
  ['Code Insee', COMMUNE.inseeCode],
  ...(mayor ? ([['Maire', mayor.name]] as [string, string][]) : []),
  ['Mairie', `${settings.street}, ${settings.postalCode} ${settings.city}`],
  ['Téléphone', settings.phone],
  ['E-mail', LEGAL.email],
];
---

<BaseLayout
  title="La commune en bref"
  description={`${COMMUNE.name} en chiffres : ${population} habitants, ${COMMUNE.department.name}, ${COMMUNE.intercommunality.name}. Horaires de la mairie, maire, histoire et questions fréquentes.`}
  jsonLd={faqSchema(faq)}
>
  <PageHeader
    title={`${COMMUNE.name} en bref`}
    crumbs={breadcrumb(content.pages, path, SECTION_LABELS)}
    intro={`${COMMUNE.name} est une commune française du département de ${COMMUNE.department.name}, en région ${COMMUNE.region}. Elle compte ${population} habitants.`}
  />
  <div class="container-site grid gap-12 py-10 lg:grid-cols-[1fr_22rem]" data-pagefind-body>
    <div class="grid content-start gap-12">
      <section class="prose-sal" aria-labelledby="titre-presentation">
        <h2 id="titre-presentation">Présentation</h2>
        <p>
          {`${COMMUNE.name} est née en ${COMMUNE.mergedIn} de la fusion de deux communes voisines, Saint-Amand-de-Vendôme et Longpré. Située dans le Vendômois, au sud-ouest de Vendôme, elle fait partie de la ${COMMUNE.intercommunality.name}.`}
        </p>
        <p>
          {`Son blason se décrit ainsi : « foliolé d’or et de gueules ». La mairie se trouve au ${settings.street}.`}
        </p>
      </section>

      <section aria-labelledby="titre-faq">
        <h2 id="titre-faq" class="mb-5 text-2xl">
          Questions fréquentes
        </h2>
        <div class="grid gap-3">
          {faq.map((item) => (
            <details class="card group p-5 open:pb-6">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-serif text-lg font-semibold">
                <h3 class="text-lg">{item.question}</h3>
                <span
                  aria-hidden="true"
                  class="text-terracotta-text transition-transform group-open:rotate-45"
                >
                  +
                </span>
              </summary>
              <p class="mt-3 text-[0.98rem] leading-relaxed">{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    </div>

    <aside class="grid content-start gap-6">
      <section class="card p-5" aria-labelledby="titre-chiffres">
        <h2 id="titre-chiffres" class="text-xl">
          Carte d’identité
        </h2>
        <dl class="mt-3 grid gap-2 text-[0.95rem]">
          {facts.map(([label, value]) => (
            <div class="grid grid-cols-[8rem_1fr] gap-2 border-b border-trait pb-2 last:border-0">
              <dt class="text-muted">{label}</dt>
              <dd class="font-semibold">{value}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-4 text-xs text-muted">
          Sources : <a href={COMMUNE.insee}>Insee</a>, API Découpage administratif
          (geo.api.gouv.fr), <a href={COMMUNE.servicePublic}>annuaire Service-Public</a>.
        </p>
      </section>
      <section class="card p-5" aria-labelledby="titre-horaires">
        <h2 id="titre-horaires" class="text-xl">
          Horaires de la mairie
        </h2>
        <dl class="mt-3 grid gap-1.5 text-[0.95rem]">
          {summarizeHours(settings.hours).map((line) => (
            <div>
              <dt class="font-bold">{line.days}</dt>
              <dd>{line.hours}</dd>
            </div>
          ))}
        </dl>
      </section>
      <section class="card p-5" aria-labelledby="titre-liens">
        <h2 id="titre-liens" class="text-xl">
          En savoir plus
        </h2>
        <ul class="mt-3 grid gap-1.5 text-[0.95rem]">
          <li>
            <a href={COMMUNE.wikipedia}>{COMMUNE.name} sur Wikipédia</a>
          </li>
          <li>
            <a href={COMMUNE.intercommunality.url}>Territoires Vendômois</a>
          </li>
          <li>
            <a href="/decouvrir/photos/">Photos de la commune</a>
          </li>
        </ul>
      </section>
    </aside>
  </div>
</BaseLayout>
