---
import type { Event } from '~/lib/content/types.ts';
import { dateBadge, formatEventTime } from '~/lib/dates.ts';
import Icon from './Icon.astro';

interface Props {
  event: Event;
  headingLevel?: 'h2' | 'h3';
}
const { event, headingLevel: Heading = 'h3' } = Astro.props;
const badge = dateBadge(event.start);
const where = event.location ?? event.address;
---

<article class="card group relative grid grid-cols-[3.75rem_1fr] items-center gap-4 p-3 transition-transform hover:-translate-y-0.5">
  <p
    class="rounded-xl bg-nuit py-2 text-center font-display leading-tight text-white"
    aria-hidden="true"
  >
    <span class="block text-[0.65rem] font-semibold tracking-[0.14em] uppercase opacity-80">
      {badge.weekday}
    </span>
    <span class="block text-2xl font-bold">{badge.day}</span>
    <span class="mx-auto my-0.5 block h-0.5 w-5 rounded-full bg-jaune"></span>
    <span class="block text-[0.65rem] font-semibold tracking-[0.14em] uppercase">
      {badge.month}
    </span>
  </p>
  <div>
    <Heading class="text-[0.98rem] leading-snug">
      <a
        href={`/agenda/${event.slug}/`}
        class="text-nuit no-underline after:absolute after:inset-0 group-hover:underline"
      >
        {event.title}
      </a>
    </Heading>
    <p class="mt-1 flex items-center gap-1.5 text-sm text-muted">
      <Icon name="clock" class="icon size-4 text-rouge" />
      <span>
        <time datetime={event.start}>
          {badge.weekday} {badge.day} {badge.month}
        </time>
        , {formatEventTime(event.start, event.end, event.allDay)}
      </span>
    </p>
    {where && (
      <p class="mt-0.5 flex items-center gap-1.5 text-sm text-muted">
        <Icon name="pin" class="icon size-4 text-rouge" />
        {where}
      </p>
    )}
  </div>
</article>
