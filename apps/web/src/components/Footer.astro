---
import type { Settings } from '~/lib/content/types.ts';
import { summarizeHours } from '~/lib/hours.ts';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Ribbons from './Ribbons.astro';

interface Props {
  settings: Settings;
}
const { settings } = Astro.props;
const hours = summarizeHours(settings.hours);
const year = new Date().getFullYear();
---

<footer class="mt-20 bg-nuit text-sable">
  <Ribbons fill="text-nuit" class="-mt-px -mb-px h-14 bg-sable sm:h-20" flip />
  <div class="container-site grid gap-10 pt-8 pb-12 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
    <div>
      <div class="flex items-center gap-3">
        <Logo class="h-14 w-auto shrink-0 text-sable" />
        <p class="font-display leading-none">
          <span class="block text-[0.68rem] font-medium tracking-[0.42em] text-nuit-muted uppercase">
            Ville de
          </span>
          <span class="mt-1.5 block text-base font-bold tracking-[0.02em] whitespace-nowrap uppercase">
            Saint-Amand-Longpré
          </span>
        </p>
      </div>
      <address class="mt-6 text-sm leading-relaxed not-italic">
        Mairie de Saint-Amand-Longpré
        <br />
        {settings.street}
        <br />
        {`${settings.postalCode} ${settings.city}`}
        <br />
        <a class="text-sable" href={`tel:${settings.phone.replace(/\s/g, '')}`}>
          {settings.phone}
        </a>
      </address>
    </div>

    <div class="lg:border-l lg:border-white/15 lg:pl-8">
      <h2 class="eyebrow text-jaune">Horaires de la mairie</h2>
      <dl class="mt-3 space-y-2 text-sm">
        {hours.map((line) => (
          <div>
            <dt class="text-nuit-muted">{line.days}</dt>
            <dd>{line.hours}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="lg:border-l lg:border-white/15 lg:pl-8">
      <h2 class="eyebrow text-jaune">Accès rapides</h2>
      <ul class="mt-3 space-y-1.5 text-sm">
        <li>
          <a class="text-sable no-underline hover:underline" href="/plan-du-site/">
            Plan du site
          </a>
        </li>
        <li>
          <a class="text-sable no-underline hover:underline" href="/mentions-legales/">
            Mentions légales
          </a>
        </li>
        <li>
          <a class="text-sable no-underline hover:underline" href="/donnees-personnelles/">
            Données personnelles
          </a>
        </li>
        <li>
          <a class="text-sable no-underline hover:underline" href="/accessibilite/">
            Accessibilité : non conforme
          </a>
        </li>
        <li>
          <a class="text-sable no-underline hover:underline" href="/contact/">
            Contact
          </a>
        </li>
      </ul>
      {settings.facebook && (
        <a
          href={settings.facebook}
          class="mt-5 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 font-display text-sm font-semibold text-sable no-underline hover:bg-white/20"
          rel="noopener noreferrer"
        >
          <Icon name="facebook" class="icon size-5" />
          Page Facebook de la commune
        </a>
      )}
    </div>

    <div class="flex flex-col items-start justify-center lg:items-end lg:border-l lg:border-white/15 lg:pl-8 lg:text-right">
      <p class="font-serif text-2xl leading-snug text-sable italic">
        Entre patrimoine,
        <br />
        nature et avenir
      </p>
      <span class="mt-4 block h-1 w-12 rounded-full bg-jaune" aria-hidden="true"></span>
    </div>
  </div>
  <div class="border-t border-white/15">
    <div class="container-site flex flex-wrap justify-between gap-2 py-4 text-xs text-nuit-muted">
      <span>© {year} Commune de Saint-Amand-Longpré</span>
      <span>Site officiel de la commune de Saint-Amand-Longpré (Loir-et-Cher)</span>
    </div>
  </div>
</footer>
