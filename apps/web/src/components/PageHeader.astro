---
import type { Crumb } from '~/lib/content/select.ts';
import { formatDate } from '~/lib/dates.ts';
import { webPage } from '~/lib/seo.ts';

interface Props {
  title: string;
  crumbs: Crumb[];
  intro?: string;
  eyebrow?: string;
  /** Date de dernière modification (AAAA-MM-JJ), affichée et déclarée aux moteurs. */
  modified?: string;
}
const { title, crumbs, intro, eyebrow, modified } = Astro.props;
const ancestors = crumbs.slice(0, -1);
const path = Astro.url.pathname;
const structured = webPage(
  Astro.site!,
  path,
  title,
  crumbs.at(-1)?.href === path ? crumbs : [...crumbs, { label: title, href: path }],
  intro,
  modified,
);
---

<div class="border-b border-trait bg-pierre">
  <div class="container-site py-8 sm:py-10">
    {ancestors.length > 0 && (
      <nav aria-label="Fil d’Ariane" class="mb-4 text-sm">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-muted">
          {ancestors.map((crumb) => (
            <li class="flex items-center gap-2">
              <a href={crumb.href} class="text-muted hover:text-terracotta-text">
                {crumb.label}
              </a>
              <span aria-hidden="true">›</span>
            </li>
          ))}
          <li aria-current="page" class="text-encre">
            {title}
          </li>
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow mb-2 text-terracotta-text">{eyebrow}</p>}
    <h1 class="max-w-4xl text-3xl sm:text-4xl lg:text-[2.6rem]">{title}</h1>
    {intro && <p class="mt-3 max-w-3xl text-lg text-muted">{intro}</p>}
    {modified && (
      <p class="mt-3 text-sm text-muted">
        Mis à jour le <time datetime={modified}>{formatDate(modified)}</time>
      </p>
    )}
    <slot />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(structured)} />
</div>
