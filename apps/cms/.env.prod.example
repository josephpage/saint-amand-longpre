# Configuration du WordPress de production — copier en .env.prod (jamais versionné).
# Générer les secrets avec : openssl rand -base64 48

# Base de données
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Clés de sécurité WordPress (https://api.wordpress.org/secret-key/1.1/salt/)
WP_AUTH_KEY=
WP_SECURE_AUTH_KEY=
WP_LOGGED_IN_KEY=
WP_NONCE_KEY=
WP_AUTH_SALT=
WP_SECURE_AUTH_SALT=
WP_LOGGED_IN_SALT=
WP_NONCE_SALT=

# Compte administrateur créé à l'installation
WP_ADMIN_USER=secretariat
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=

# Secret partagé avec le site (PREVIEW_SECRET du projet Cloudflare Pages, même valeur)
PREVIEW_SECRET=

# Reconstruction du site après publication (jeton GitHub à droits limités :
# « Contents : read and write » sur le seul dépôt du site)
GITHUB_REPO=josephpage/saint-amand-longpre
GITHUB_TOKEN=

# HTTPS (Caddy) : adresse de contact de Let's Encrypt
ACME_EMAIL=secretariat@saintamandlongpre.fr

# Mot de passe supplémentaire de l'administration (/wp-admin).
# Empreinte à générer avec :
#   docker run --rm caddy:2.11.4-alpine caddy hash-password
# et à coller entre apostrophes (elle contient des « $ »).
ADMIN_AUTH_USER=mairie
ADMIN_AUTH_HASH=''

# Sauvegardes vers Cloudflare R2 (compatible S3), chiffrées par GPG
BACKUP_S3_ENDPOINT=<identifiant-de-compte>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=sal-sauvegardes
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_PASSPHRASE=
